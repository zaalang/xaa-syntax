{
    "name": "zaa-syntax",
    "displayName": "Zaalang Syntax",
    "version": "0.0.1",
    "description": "Zaalang syntax highlighting",
    "publisher": "pniekamp",
    "homepage": "https://github.com/zaalang/zaa-syntax",
    "author": {
        "name": "pniekamp"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/zaalang/zaa-syntax"
    },
    "bugs": {
        "url": "https://github.com/zaalang/zaa-syntax/issues"
    },
    "license": "Please see LICENSE.txt",
    "galleryBanner": {
        "color": "#292d3e",
        "theme": "dark"
    },
    "icon": "images/icon.png",
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "zaalang",
        "language",
        "syntax",
        "grammar",
        "highlighting"
    ],
    "contributes": {
        "languages": [
            {
                "id": "zaalang",
                "extensions": [".zaa"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "zaalang",
                "scopeName": "source.zaa",
                "path": "./syntaxes/zaalang.tmLanguage.json"
            }
        ]
    },
    "devDependencies": {
        "js-yaml": "^4.1.1",
        "vsce": "^2.9.2"
    },
    "engines": {
        "vscode": "^1.44.0"
    }
}
